# Server-only. Never prefix a Supabase secret or admin secret with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# Set to your exact production origin, with https:// in production.
SITE_URL=http://localhost:3000
# Generate with npm run admin:hash, piping the password through stdin.
ADMIN_PASSWORD_HASH=
# Generate a random secret of at least 32 characters. Rotating either admin
# secret or password hash invalidates existing signed sessions.
ADMIN_SESSION_SECRET=
